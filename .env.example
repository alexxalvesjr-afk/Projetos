# ---------------------------------------------------------------------------
# Revend CRM — environment configuration
# Copy to `.env` and fill in. Never commit the resulting file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mypremium?schema=public"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical URL of the deployment (used for SEO, sitemaps, callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# UploadThing — https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# Set to "true" to trust the X-Forwarded-Host header (needed behind proxies)
AUTH_TRUST_HOST="true"

# Set to "true" once UPLOADTHING_TOKEN is configured; enables the uploader UI.
NEXT_PUBLIC_UPLOADTHING_ENABLED="false"

# Mostra os botões de acesso rápido na tela de login (Proprietária/Gerente/Vendedor).
# Deixe vazio ou "false" em produção real — em um deploy de demonstração, "true".
NEXT_PUBLIC_DEMO_MODE="false"

# Autoriza GET /api/setup?token=... a carregar (ou recarregar, com &force=true) o
# banco de dados a partir do navegador — sem terminal. Gere com:
# openssl rand -base64 24
# Deixe indefinida para desativar a rota por completo.
SETUP_TOKEN=""

# Endereço do site público da revenda (o site oficial, hospedado na Netlify).
# É para cá que apontam os botões "abrir site" e "ver no site" do CRM.
NEXT_PUBLIC_SITE_URL="https://cosmic-tarsier-ef085b.netlify.app"

# Site próprio da revenda, hospedado fora daqui (Netlify).
# Só é necessário se esse site lê o estoque no momento do BUILD. Cada carro
# cadastrado, editado ou vendido dispara um novo deploy dele.
# Pegue em: Netlify → Site configuration → Build & deploy → Build hooks.
# Sites que buscam o feed pelo navegador não precisam disso — deixe vazio.
NETLIFY_BUILD_HOOK_URL=""
