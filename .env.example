# ---------------------------------------------------------------------------
# Revend CRM — environment configuration
# Copy to `.env` and fill in. Never commit the resulting file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/revend?schema=public"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical URL of the deployment (used for SEO, sitemaps, callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# UploadThing — https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# Set to "true" to trust the X-Forwarded-Host header (needed behind proxies)
AUTH_TRUST_HOST="true"

# Set to "true" once UPLOADTHING_TOKEN is configured; enables the uploader UI.
NEXT_PUBLIC_UPLOADTHING_ENABLED="false"
